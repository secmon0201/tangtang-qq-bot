# QQ 本地数据机器人配置模板
#
# 读取规则：除 AI_* 配置外，以下变量均在 NoneBot 启动时读取；修改后重启
# NoneBot 才会生效。不要在这里填写 QQ 密码、验证码或登录 Cookie。

# ============================================================================
# 一、启动级别与身份配置（修改 .env 后需要重启）
# ============================================================================

# 当前 SnowLuma/OneBot 个人 QQ 链路。QQ 登录与验证由用户手动完成。
BOT_TRANSPORT=onebot
QQ_ACCOUNT_ID=
QQ_PLATFORM_TRANSPORT=snowluma
SNOWLUMA_DIR=SnowLuma
SNOWLUMA_WEBUI_PORT=5099
# Optional rollback/compatibility transport.
LAGRANGE_DIR=Lagrange.OneBot

# 机器人初始管理群的迁移种子；群数量不设上限，运行时以数据库登记为准。
MANAGED_GROUP_IDS=

# 超级管理员：可执行跨群查重、白名单、集群和系统参数管理。
BOT_OPERATOR_IDS=
# 公告面板专用名单：逗号分隔 QQ 号。名单成员可使用 #公告面板，
# 但不会获得其他超级管理员权限；留空时仅超级管理员可用。
GLOBAL_ANNOUNCEMENT_OPERATOR_IDS=
# 内部公告接口的默认目标集群名称或别名；公告面板仍可逐次多选目标。
GLOBAL_ANNOUNCEMENT_DEFAULT_CLUSTER=

# 基础命令与定时任务。
BOT_COMMAND_PREFIX=#
BOT_TIMEZONE=Asia/Shanghai
BOT_ROLLUP_HOUR=1
BOT_ROLLUP_MINUTE=5
BOT_REQUIRE_MENTION=false
# 反馈意见会按该间隔私聊发送给所有 BOT_OPERATOR_IDS；单位为秒。
FEEDBACK_NOTIFICATION_INTERVAL_SECONDS=600

# NoneBot 本地 HTTP/WebSocket 服务；SnowLuma 反向 WebSocket 指向：
# ws://127.0.0.1:8080/onebot/v11/ws
HOST=127.0.0.1
PORT=8080
ONEBOT_ACCESS_TOKEN=

# 可选公网入口与图片署名。域名和个人署名属于实例信息，公开模板保持空值。
PUBLIC_SITE_BASE_URL=
PUBLIC_SHORT_HOST=
PUBLIC_TUNNEL_NAME=
PUBLIC_GENERATOR_CREDIT=

# QQ 传输连接维护：NoneBot 每隔一段时间检查 OneBot 反向 WebSocket 是否仍在线。
# 仅在“已连接后断开”时记录本地 SQLite 事件；不会尝试绕过 QQ 的登录验证。
QQ_TRANSPORT_MAINTENANCE_ENABLED=true
QQ_TRANSPORT_MAINTENANCE_INTERVAL_SECONDS=30

# Codex 测试群通知：仅允许本机脚本向固定群的固定超级管理员发送完成提醒、
# 测试用例、普通通知和项目目录内的本地图片。调用方不能指定其他群或账号。
# 留空时 CODEX_COMPLETION_NOTIFY_TOKEN 使用 ONEBOT_ACCESS_TOKEN；通知目标必须
# 同时属于 MANAGED_GROUP_IDS 和 BOT_OPERATOR_IDS，启动时会校验。
CODEX_COMPLETION_NOTIFY_ENABLED=false
CODEX_COMPLETION_NOTIFY_GROUP_ID=
CODEX_COMPLETION_NOTIFY_SUPER_ADMIN_ID=
CODEX_COMPLETION_NOTIFY_TOKEN=

LOG_LEVEL=WARNING

# SQLite 数据库位置。改动后需要重启，已有数据库不会自动搬迁。
BOT_DB_PATH=data/bot.db

# ============================================================================
# 二、旧功能范围迁移种子（仅首次迁移读取）
# ============================================================================
# 运行中的群功能只以 SQLite 为准；群管理员通过 #群设置 修改当前群。
DUPLICATE_GROUP_IDS=
GAME_GROUP_IDS=
GAME_API_GROUP_IDS=

# Guess-number cursed values: never selected as answers. Guessing one recalls the message and mutes the player.
MINI_GAME_GUESS_CURSED_NUMBERS=510,731,444,33

# 枝江直播日程防护：使用 ASoul-Calendar 的公开基础日程数据。
# 每 5 分钟拉取一次（不少于每小时），在开播时关闭小游戏总开关；默认 60 分钟后自动恢复。
# 直播数据请求失败时保留本地最后一次有效缓存，绝不因失败改变小游戏开关。
ZHIJIANG_LIVE_GUARD_ENABLED=true
ZHIJIANG_SCHEDULE_URL=https://raw.githubusercontent.com/Evelynall/ASoul-Data/main/base-schedules.json
ZHIJIANG_SCHEDULE_REFRESH_MINUTES=5
ZHIJIANG_LIVE_PAUSE_MINUTES=60
ZHIJIANG_SCHEDULE_LOOKAHEAD_DAYS=7
ZHIJIANG_SCHEDULE_TIMEOUT=15

# A-SOUL 直播日程与 B 站播报：日程查询始终可用，B 站自动播报默认关闭。
# ASOUL_BILI_GROUP_IDS 仅作为首次迁移种子；运行时以各群 SQLite 开关为准。
# 凭据只能通过超级管理员私聊 #bili_login 写入本机 SQLite，不能填写到 .env 或发到群内。
ASOUL_BILI_ENABLED=false
ASOUL_BILI_POLL_INTERVAL_SECONDS=60
ASOUL_BILI_GROUP_IDS=
ASOUL_BILI_TARGET_UIDS=672328094,672342685,3537115310721181,3537115310721781,672353429,703007996,3493085336046382,3493082517474232
# 评论区主人和评论作者均只限嘉然、乃琳、心宜、思诺、贝拉。
ASOUL_BILI_COMMENT_TARGET_UIDS=672328094,672342685,3537115310721181,3537115310721781,672353429
ASOUL_BILI_PUSH_DYNAMIC=true
# 投稿视频由动态接口识别并使用视频卡片；不会独立轮询视频列表。
ASOUL_BILI_PUSH_VIDEO=true
ASOUL_BILI_PUSH_LIVE=true
ASOUL_BILI_PUSH_COMMENT=false
# 动态、视频、开播和评论推送默认附带本地生成的图片卡片；异常时仍会自动发送文本。
ASOUL_BILI_RENDER_CARDS=true

# ============================================================================
# 三、基础响应与本地节流（修改 .env 后需要重启）
# ============================================================================
# 普通互动（随机表情、随机/三连复读、@机器人的表情确认）发送前随机延迟。
BOT_RESPONSE_DELAY_MIN_SECONDS=2
BOT_RESPONSE_DELAY_MAX_SECONDS=5
# # 指令及小游戏反馈发送前随机延迟。状态更新会先完成，不会被该等待阻塞。
BOT_COMMAND_RESPONSE_DELAY_MIN_SECONDS=1
BOT_COMMAND_RESPONSE_DELAY_MAX_SECONDS=2
BOT_ONEBOT_API_MIN_INTERVAL_SECONDS=0.5
DUPLICATE_SCAN_COOLDOWN_SECONDS=300
BOT_MENTION_ACK_EMOJI_IDS=14,20,21,43,49,66,76,78,79,99,118,124,180,199,201,228,282,294,299,315,319,320,341,346

# ============================================================================
# 四、被动互动（范围、命中率、冷却和间隔可通过管理员命令热更）
# ============================================================================
# BOT_RANDOM_*_ENABLED、BOT_*_EMOJI_IDS 属于启动开关/候选列表，修改后需要重启。
BOT_RANDOM_REACTION_ENABLED=false
BOT_RANDOM_REACTION_GROUP_IDS=
BOT_RANDOM_REACTION_PROBABILITY=0.15
BOT_RANDOM_REACTION_COOLDOWN_SECONDS=180
BOT_RANDOM_REACTION_EMOJI_IDS=14,20,21,43,49,66,76,78,79,99,118,124,180,199,201,228,282,294,299,315,319,320,341,346
BOT_RANDOM_REPEAT_ENABLED=true
# The following comma-separated values map one-to-one to BOT_RANDOM_REACTION_GROUP_IDS.
BOT_RANDOM_REPEAT_PROBABILITY=
BOT_RANDOM_REPEAT_COOLDOWN_SECONDS=
BOT_RANDOM_REPEAT_MESSAGE_INTERVAL=
BOT_RANDOM_TRIPLE_REPEAT_ENABLED=
BOT_RANDOM_TRIPLE_REPEAT_PROBABILITY=

# ============================================================================
# 五、整点报时（新独群默认关闭；群开关由 #群设置 管理）
# ============================================================================
HOURLY_ANNOUNCEMENT_ENABLED=false
HOURLY_ANNOUNCEMENT_GROUP_IDS=
HOURLY_ANNOUNCEMENT_START=00:00
HOURLY_ANNOUNCEMENT_END=23:00
HOURLY_ANNOUNCEMENT_MAX_ATTEMPTS=3

# ============================================================================
# 七、本地图片、头像和数据保存
# ============================================================================
REPORT_OUTPUT_MODE=local_image
REPORT_DIR=data/reports
REPORT_FONT_PATH=
REPORT_RETENTION_HOURS=24
AVATAR_BASE_URL=https://q1.qlogo.cn/g?b=qq&nk={user_id}&s=640
AVATAR_CACHE_DIR=data/avatar_cache
AVATAR_TIMEOUT=5
AVATAR_CACHE_TTL=604800
# 到期后仅在头像实际被渲染时探测一次；成功后重新计时，默认 1 小时。
AVATAR_REFRESH_INTERVAL_SECONDS=3600
# 头像源失败后的单用户退避时间，避免重复请求。
AVATAR_REFRESH_COOLDOWN_SECONDS=900
# 每次渲染最多刷新 24 个头像，并发数限制为 2。
AVATAR_REFRESH_MAX_PER_CALL=24
AVATAR_REFRESH_CONCURRENCY=2

# ============================================================================
# 八、QQ 群活跃概况采集器（默认关闭；私有接口需自行确认）
# ============================================================================
STATS_REALTIME_ENABLED=true
# A海岸发言画像临时开关；false 时 #发言画像/#画像 直接提示已关闭，不调用 AI。
A_COAST_PROFILE_ENABLED=true
# ============================================================================
# 九、GsUID Core（只启用异环 NTEUID 与鸣潮 XutheringWavesUID）
# ============================================================================
# GSUID_ENABLED=true 时加载 Core 连接器并启动本机 GsUID.Core。
# 游戏接口识别 nte 与 ww 前缀，可带或不带 #，大小写不敏感；gs/ys/yh/gsuid 保持禁用。
# GAME_API_GROUP_IDS 只作为 nte 与 ww 群开关的首次迁移种子，运行时以 SQLite 为准。
# 全局热开关用私聊 #系统设置 游戏接口 状态|开|关；关闭不会改写各群意图。
GSUID_ENABLED=false
GAME_API_ENABLED=true
GSUID_CORE_DIR=GsUID.Core
WUWA_IMPORT_CLUSTER_NAME=
gsuid_core_host=127.0.0.1
gsuid_core_port=8765
gsuid_core_ws_token=
gsuid_core_botid=QQLocalDataBot
gsuid_core_repeat=true

# ============================================================================
# 十、QQ 官方 OpenAPI（不用时保持 BOT_TRANSPORT=onebot）
# ============================================================================
QQ_OPENAPI_APP_ID=
QQ_OPENAPI_TOKEN=
QQ_OPENAPI_APP_SECRET=
QQ_OPENAPI_SANDBOX=true
QQ_OPENAPI_PORT=8081

# ============================================================================
# 十、发言画像 AI（复用糖糖接口；PROFILE_* 与 TANGTANG_* 均可热更新）
# ============================================================================
# PROFILE_API_URL/PROFILE_API_KEY/PROFILE_API_STYLE/PROFILE_MODEL/
# PROFILE_REASONING_EFFORT 缺省时自动沿用对应的 TANGTANG_* 值。
PROFILE_ENABLED=false
PROFILE_API_URL=https://api.deepseek.com
PROFILE_API_STYLE=responses
PROFILE_MODEL=deepseek-v4-flash
PROFILE_REASONING_EFFORT=max
PROFILE_TIMEOUT_SECONDS=120
PROFILE_MAX_INPUT_CHARS=32000
PROFILE_MAX_OUTPUT_TOKENS=16000
PROFILE_MAX_RESPONSE_CHARS=16000
PROFILE_CHUNK_CHARS=24000
PROFILE_MAX_RECORDS_PER_RUN=30000
PROFILE_MAX_CONCURRENT=3
PROFILE_RETRY_MAX_ATTEMPTS=3
PROFILE_RETRY_BASE_SECONDS=2
PROFILE_MERGE_CHUNK_CHARS=24000
PROFILE_EVIDENCE_CONCURRENCY=8
PROFILE_EVIDENCE_REASONING_EFFORT=none
PROFILE_EVIDENCE_MAX_CHARS=8000
PROFILE_EVIDENCE_MAX_TOKENS=8000
PROFILE_EVIDENCE_MAX_RESPONSE_CHARS=16000
PROFILE_FINAL_MAX_CHARS=4000
PROFILE_FINAL_MAX_TOKENS=8000
PROFILE_FINAL_MAX_RESPONSE_CHARS=16000

# 十一、糖糖 AI 聊天（独立模块；纯文件维护，TANGTANG_* 热更新）
TANGTANG_ENABLED=false
TANGTANG_MODE=d
TANGTANG_CALL_KEYWORD=糖糖
TANGTANG_GROUP_IDS=
TANGTANG_GROUP_CONTEXT_MESSAGES=30
TANGTANG_IGNORE_PROBABILITY=0.05
# 可选：按 TANGTANG_GROUP_IDS 顺序覆盖被呼叫时的忽略概率；空值时使用上一项全局配置。
TANGTANG_CALL_IGNORE_PROBABILITY=
# 可选：这些群被呼叫时，模型沉默会改用本地台词兜底回复。
TANGTANG_REQUIRED_CALL_REPLY_GROUP_IDS=
# Additional ignore probability after a called message matches the soft blacklist.
TANGTANG_SOFT_BLACKLIST_IGNORE_PROBABILITY=0.00
TANGTANG_C_PROBABILITY=0.40
TANGTANG_API_URL=https://api.deepseek.com
TANGTANG_API_KEY=
TANGTANG_API_STYLE=responses
TANGTANG_MODEL=deepseek-flash
TANGTANG_REASONING_EFFORT=none
# 可选模型档案；取消注释并填写后，可由 `#糖糖模型 <档案名>` 热切换。
# 继续增加 PROFILE_2、PROFILE_3 等编号即可扩展，编号不要求连续。
# TANGTANG_MODEL_ACTIVE_PROFILE=模型1
# TANGTANG_MODEL_PROFILE_1_NAME=模型1
# TANGTANG_MODEL_PROFILE_1_PROVIDER=deepseek
# TANGTANG_MODEL_PROFILE_1_API_URL=
# TANGTANG_MODEL_PROFILE_1_API_KEY=
# TANGTANG_MODEL_PROFILE_1_API_STYLE=chat_completions
# TANGTANG_MODEL_PROFILE_1_MODEL=
# TANGTANG_MODEL_PROFILE_1_REASONING_EFFORT=none
# TANGTANG_MODEL_PROFILE_1_VISION_DETAIL=low
TANGTANG_TIMEOUT_SECONDS=30
TANGTANG_MAX_INPUT_CHARS=2000
TANGTANG_MAX_OUTPUT_TOKENS=512
TANGTANG_MAX_RESPONSE_CHARS=1200
# 多模态图片理解；仅解析 OneBot 图片段，不抓取消息正文里的任意 URL。
TANGTANG_VISION_ENABLED=true
TANGTANG_VISION_MAX_IMAGES=4
TANGTANG_VISION_MAX_IMAGE_BYTES=8388608
TANGTANG_VISION_MAX_TOTAL_BYTES=16777216
TANGTANG_VISION_MAX_PIXELS=20000000
TANGTANG_VISION_MAX_DIMENSION=1000
TANGTANG_VISION_TIMEOUT_SECONDS=10
# `low` 让模型侧按 512×512 处理图片，适合日常群聊并节省视觉 token。
TANGTANG_VISION_DETAIL=low
# 自然消息气泡：第一条引用原消息，后续消息按顺序普通发送。
TANGTANG_REPLY_BUBBLES_ENABLED=true
TANGTANG_REPLY_MAX_BUBBLES=6
TANGTANG_REPLY_DELAY_MIN_MS=500
TANGTANG_REPLY_DELAY_MAX_MS=1400
# 严格按群和用户隔离的长期记忆与缓慢变化的人格状态。
TANGTANG_MEMORY_ENABLED=true
TANGTANG_MEMORY_RECALL_LIMIT=5
TANGTANG_PERSONA_STATE_ENABLED=true
TANGTANG_HISTORY_MESSAGES=10
# 0 表示不再按字符裁掉历史；原文仍完整保存在本地 SQLite。
TANGTANG_HISTORY_CHARS=1000
TANGTANG_CONTEXT_LAYOUT=v1
TANGTANG_CONTEXT_COMPACTION_ENABLED=false
TANGTANG_NATIVE_ACTION_TOOLS=false
# 群聊话题摘要的增量归档；关闭时不影响原有聊天路径。
TANGTANG_GROUP_SUMMARY_ENABLED=true
TANGTANG_GROUP_SUMMARY_INJECT_TOPICS=3
TANGTANG_GROUP_SUMMARY_BATCH_MESSAGES=200
TANGTANG_GROUP_SUMMARY_MAX_AGE_HOURS=6
TANGTANG_GROUP_SUMMARY_TOPIC_LIMIT=200
TANGTANG_TOOL_LOOP_MAX=3

# 糖糖回复后处理：去除客服收尾、捧场前缀、假坦白开头等 AI 腔（默认开启）
TANGTANG_HUMANIZE_ENABLED=true

# 糖糖主动回复：开启后会对未呼叫的普通群聊按概率尝试主动接话（默认关闭）
TANGTANG_PROACTIVE_ENABLED=false
# These comma-separated values map one-to-one to TANGTANG_GROUP_IDS.
TANGTANG_PROACTIVE_PROBABILITY=
TANGTANG_PROACTIVE_COOLDOWN_SECONDS=
TANGTANG_PROACTIVE_MESSAGE_INTERVAL=

# Optional local Node model gateway supervision (absolute script path; secrets stay local).
MODEL_GATEWAY_ENABLED=false
MODEL_GATEWAY_SCRIPT=
MODEL_GATEWAY_NODE=
MODEL_GATEWAY_HEALTH_URL=http://127.0.0.1:3123/v1/models
MODEL_GATEWAY_API_KEY=
